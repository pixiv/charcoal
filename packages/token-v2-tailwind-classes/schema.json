{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pixiv.github.io/charcoal/token-v2-tailwind-classes.schema.json",
  "title": "Charcoal token v2 recommended Tailwind class mappings",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "tokenPath",
      "themeEntries",
      "classCandidates",
      "category",
      "source",
      "mappingKind"
    ],
    "properties": {
      "tokenPath": { "type": "string" },
      "cssVariable": { "type": "string", "pattern": "^--charcoal-" },
      "themeEntries": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["themePath"],
          "properties": {
            "themePath": { "type": "string" },
            "themeValue": {
              "oneOf": [
                { "type": "string" },
                {
                  "type": "array",
                  "prefixItems": [
                    { "type": "string" },
                    {
                      "type": "object",
                      "additionalProperties": { "type": "string" }
                    }
                  ],
                  "minItems": 2,
                  "maxItems": 2
                }
              ]
            }
          }
        }
      },
      "classCandidates": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["className", "utility", "cssProperties"],
          "properties": {
            "className": { "type": "string" },
            "utility": {
              "enum": [
                "backgroundColor",
                "textColor",
                "borderColor",
                "fill",
                "stroke",
                "spacing",
                "gap",
                "width",
                "borderRadius",
                "borderWidth",
                "fontSize",
                "fontWeight"
              ]
            },
            "cssProperties": {
              "type": "array",
              "items": {
                "enum": [
                  "background-color",
                  "color",
                  "border-color",
                  "fill",
                  "stroke",
                  "padding",
                  "margin",
                  "gap",
                  "width",
                  "border-radius",
                  "border-width",
                  "font-size",
                  "font-weight",
                  "line-height"
                ]
              }
            }
          }
        }
      },
      "category": {
        "enum": [
          "color",
          "borderColor",
          "space",
          "radius",
          "text",
          "paragraphWidth",
          "borderWidth"
        ]
      },
      "source": { "const": "token-v2" },
      "mappingKind": { "const": "recommended" }
    }
  }
}
