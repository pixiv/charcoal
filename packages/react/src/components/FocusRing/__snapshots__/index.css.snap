.charcoal-focus-ring:is(:not(:disabled):not([aria-disabled]), [aria-disabled='false']):focus-visible {
  outline: none;
  box-shadow: inset 0 0 0 var(--charcoal-border-width-focus-1)
        var(--charcoal-color-border-focus-1),
      0 0 0 var(--charcoal-border-width-focus-2)
        var(--charcoal-color-border-focus-2);
  transition: 0.2s box-shadow;
}

