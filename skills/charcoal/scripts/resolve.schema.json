{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pixiv.github.io/charcoal/skills/charcoal/resolve.schema.json",
  "title": "Charcoal token resolve result",
  "description": "stdout 契約。ヒットも構造化ミスも exit 0。使い方エラーだけ stderr + exit 1。",
  "oneOf": [
    { "$ref": "#/$defs/semanticHit" },
    { "$ref": "#/$defs/primitiveHit" },
    { "$ref": "#/$defs/miss" }
  ],
  "$defs": {
    "tailwind": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "recommended", "alsoValid"],
      "properties": {
        "key": { "type": "string" },
        "recommended": {
          "type": "array",
          "items": { "type": "string" }
        },
        "alsoValid": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "relatedEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["css", "tailwind"],
      "properties": {
        "css": { "type": "string", "pattern": "^--charcoal-" },
        "tailwind": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "recommendedSemantic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["figma"],
      "properties": {
        "figma": { "type": "string" },
        "reason": { "type": "string" }
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "figma": { "type": "string" },
        "css": { "type": "string" },
        "tailwind": {
          "type": "array",
          "items": { "type": "string" }
        },
        "score": { "type": "number" }
      }
    },
    "mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tokenPath", "classCandidates"],
      "properties": {
        "tokenPath": { "type": "string" },
        "classCandidates": {
          "type": "array",
          "items": { "type": "object" }
        }
      }
    },
    "semanticHit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "query",
        "ok",
        "layer",
        "category",
        "group",
        "figma",
        "css",
        "cssUsage",
        "tailwind",
        "related",
        "notes"
      ],
      "properties": {
        "query": { "type": "string" },
        "ok": { "const": true },
        "layer": { "const": "semantic" },
        "category": { "type": "string" },
        "group": { "type": "string" },
        "kind": { "type": "string" },
        "figma": { "type": "string" },
        "css": { "type": "string", "pattern": "^--charcoal-" },
        "cssUsage": { "type": "string" },
        "tailwind": { "$ref": "#/$defs/tailwind" },
        "related": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/relatedEntry" }
        },
        "mapping": { "$ref": "#/$defs/mapping" },
        "notes": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "primitiveHit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "query",
        "ok",
        "layer",
        "css",
        "recommendedSemantic",
        "notes"
      ],
      "properties": {
        "query": { "type": "string" },
        "ok": { "const": true },
        "layer": { "const": "primitive" },
        "css": { "type": "string", "pattern": "^--charcoal-" },
        "figma": { "type": "string" },
        "recommendedSemantic": {
          "type": "array",
          "items": { "$ref": "#/$defs/recommendedSemantic" }
        },
        "notes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        }
      }
    },
    "miss": {
      "type": "object",
      "additionalProperties": false,
      "required": ["query", "ok", "reason", "message", "candidates"],
      "properties": {
        "query": { "type": "string" },
        "ok": { "const": false },
        "reason": {
          "enum": ["not_found", "ambiguous", "hex", "token_v1"]
        },
        "message": { "type": "string" },
        "candidates": {
          "type": "array",
          "items": { "$ref": "#/$defs/candidate" }
        }
      }
    }
  }
}
